<svg width="100%" height="220" viewBox="0 0 1200 220" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0a0a12"/>
      <stop offset="55%" stop-color="#150a1f"/>
      <stop offset="100%" stop-color="#1a0508"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="35%" r="70%">
      <stop offset="0%" stop-color="#ff2d3a" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#ff2d3a" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="thread" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7fd6ff"/>
      <stop offset="100%" stop-color="#ff3b3b"/>
    </linearGradient>
  </defs>

  <rect width="1200" height="220" fill="url(#bg)"/>
  <rect width="1200" height="220" fill="url(#glow)"/>

  <!-- Web radiating from top-left corner -->
  <g stroke="#8fb8d6" stroke-width="1" fill="none" opacity="0.55">
    <path d="M0,0 L260,220" >
      <animate attributeName="stroke-dasharray" from="0,400" to="400,0" dur="2.2s" fill="freeze"/>
    </path>
    <path d="M0,0 L520,220">
      <animate attributeName="stroke-dasharray" from="0,600" to="600,0" dur="2.2s" begin="0.15s" fill="freeze"/>
    </path>
    <path d="M0,0 L780,220">
      <animate attributeName="stroke-dasharray" from="0,850" to="850,0" dur="2.2s" begin="0.3s" fill="freeze"/>
    </path>
    <path d="M0,0 L1040,180">
      <animate attributeName="stroke-dasharray" from="0,1050" to="1050,0" dur="2.2s" begin="0.45s" fill="freeze"/>
    </path>
    <path d="M0,0 L1200,60">
      <animate attributeName="stroke-dasharray" from="0,1200" to="1200,0" dur="2.2s" begin="0.6s" fill="freeze"/>
    </path>
    <!-- arcs connecting the radial threads -->
    <path d="M40,0 Q140,90 30,150" >
      <animate attributeName="stroke-dasharray" from="0,300" to="300,0" dur="1.6s" begin="1s" fill="freeze"/>
    </path>
    <path d="M110,0 Q280,110 90,210">
      <animate attributeName="stroke-dasharray" from="0,400" to="400,0" dur="1.6s" begin="1.2s" fill="freeze"/>
    </path>
    <path d="M220,0 Q460,120 200,220">
      <animate attributeName="stroke-dasharray" from="0,520" to="520,0" dur="1.6s" begin="1.4s" fill="freeze"/>
    </path>
    <path d="M400,0 Q650,130 380,200">
      <animate attributeName="stroke-dasharray" from="0,560" to="560,0" dur="1.6s" begin="1.6s" fill="freeze"/>
    </path>
  </g>

  <!-- Web radiating from top-right corner -->
  <g stroke="#e69bab" stroke-width="1" fill="none" opacity="0.4">
    <path d="M1200,0 L960,220">
      <animate attributeName="stroke-dasharray" from="0,400" to="400,0" dur="2.2s" begin="0.2s" fill="freeze"/>
    </path>
    <path d="M1200,0 L700,220">
      <animate attributeName="stroke-dasharray" from="0,650" to="650,0" dur="2.2s" begin="0.4s" fill="freeze"/>
    </path>
    <path d="M1160,0 Q1000,100 1170,180">
      <animate attributeName="stroke-dasharray" from="0,320" to="320,0" dur="1.6s" begin="1.3s" fill="freeze"/>
    </path>
    <path d="M1090,0 Q880,110 1100,210">
      <animate attributeName="stroke-dasharray" from="0,420" to="420,0" dur="1.6s" begin="1.5s" fill="freeze"/>
    </path>
  </g>

  <!-- hanging thread with spider -->
  <line x1="600" y1="0" x2="600" y2="120" stroke="url(#thread)" stroke-width="1.5" opacity="0.8">
    <animate attributeName="y2" values="0;120;0" dur="0s" fill="freeze"/>
  </line>

  <g>
    <animateTransform attributeName="transform" type="translate"
      values="0,0; 0,60; 0,10; 0,90; 0,40; 0,120; 0,120"
      keyTimes="0; 0.15; 0.3; 0.5; 0.65; 0.85; 1"
      dur="6s" repeatCount="indefinite"/>
    <g transform="translate(600,0)">
      <ellipse cx="0" cy="0" rx="7" ry="9" fill="#111"/>
      <circle cx="0" cy="-6" r="4.5" fill="#111"/>
      <circle cx="-1.8" cy="-7" r="1.1" fill="#ff3b3b"/>
      <circle cx="1.8" cy="-7" r="1.1" fill="#ff3b3b"/>
      <g stroke="#111" stroke-width="1.4">
        <line x1="0" y1="-2" x2="-11" y2="-8"/>
        <line x1="0" y1="0" x2="-13" y2="0"/>
        <line x1="0" y1="2" x2="-11" y2="8"/>
        <line x1="0" y1="-2" x2="11" y2="-8"/>
        <line x1="0" y1="0" x2="13" y2="0"/>
        <line x1="0" y1="2" x2="11" y2="8"/>
      </g>
    </g>
  </g>

  <!-- title text -->
  <text x="50%" y="52%" text-anchor="middle" font-family="Segoe UI, Verdana, sans-serif"
        font-size="42" font-weight="700" fill="#f5f5f5" opacity="0">
    Hi, I'm Wasiq
    <animate attributeName="opacity" from="0" to="1" dur="1s" begin="1.8s" fill="freeze"/>
  </text>
  <text x="50%" y="66%" text-anchor="middle" font-family="Segoe UI, Verdana, sans-serif"
        font-size="18" fill="#c9c9d6" opacity="0">
    Computer Engineering @ COMSATS · Building things, one commit at a time
    <animate attributeName="opacity" from="0" to="1" dur="1s" begin="2.3s" fill="freeze"/>
  </text>
</svg>
